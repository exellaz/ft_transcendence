{
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@usebruno/cli": "^2.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.3",
    "bcrypt": "^6.0.0",
    "fastify": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "tsconfig-paths": "^4.2.0",
    "vite": "^7.1.7",
    "ws": "^8.18.3"
  },
  "scripts": {
    "lint": "eslint backend shared frontend",
    "lint:fix": "eslint backend shared frontend --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:frontend": "eslint frontend/",
    "lint:backend": "eslint backend/",
    "lint:shared": "eslint shared/",
    "format:frontend": "prettier --write frontend/",
    "format:backend": "prettier --write backend/",
    "format:shared": "prettier --write shared/",
    "type-check": "concurrently \"npm run type-check --prefix frontend\" \"npm run type-check --prefix backend\" \"tsc --noEmit --project shared/tsconfig.json\""
  }
}
