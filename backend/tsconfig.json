{
  "compilerOptions": {
    // File Layout
    "rootDir": "../",
    "outDir": "./dist",

    // Environment
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Debugging
    "sourceMap": true,

    // Type Safety
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Performance
    "skipLibCheck": true,

    // Module interop
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "noEmit": true,

    // 🔑 Needed for @shared/*
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*", "../shared/*"]
    }
  },
  "include": ["src"]
}
