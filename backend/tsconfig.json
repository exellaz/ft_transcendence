{
  "compilerOptions": {
    // File Layout
    "rootDir": "../",
    "outDir": "./dist",

    // Environment
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // Debugging
    "sourceMap": true,

    // Type Safety
    "strict": false,
    "noUncheckedIndexedAccess": true,

    // Performance
    "skipLibCheck": true,

    // Module interopjs"
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "noEmit": true,

    // 🔑 Needed for @shared/*
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared/utils", "../shared/client.ts", "../shared/entry_test.ts", "../shared/game.routes.ts", "../shared/server.ts", "../shared/objects", "../shared/game"]
}
