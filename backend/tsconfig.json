{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Debugging
    "sourceMap": true,

    // Type Safety
    "strict": false,
    "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Performance
    "skipLibCheck": true,

    // Module interop
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
