// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ENUMS
enum FriendshipStatus {
  pending
  accepted
}

enum Language {
  english
  simplified_chinese
  traditional_chinese
}

enum userStatus {
  online
  offline
  ingame
}

// MODELS
model User {
  id         Int            @id @default(autoincrement())
  username   String         @unique
  password   String
  email      String         @unique
  avatarUrl  String         @default("/assets/yellow-ghost.png") @map("avatar_url")
  status     userStatus     @default(offline) @map("status")
  joinedAt   DateTime       @default(now()) @map("joined_at")
  updatedAt  DateTime       @default(now()) @map("updated_at")

  // Relations
  settings   UserSettings?

  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAccepter")

  blockedUsers       BlockedFriendship[] @relation("Blocks")   // people I blocked
  blockedBy          BlockedFriendship[] @relation("BlockedBy") // people who blocked me

  friendChatMessages FriendChatMessage[] 

  @@map("users")
}

model UserSettings {
  userId    Int                       @id @map("user_id")
  language  Language                  @default(english)

  // Relation
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Friendship {
  id        Int               @id @default(autoincrement())
  requesterId    Int               @map("user_id")
  accepterId  Int               @map("friend_id")
  status    FriendshipStatus  @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @map("updated_at")

  // Relations
  requester   User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  accepter    User @relation("FriendshipAccepter", fields: [accepterId], references: [id], onDelete: Cascade)

  chatMessages FriendChatMessage[]

  @@unique([requesterId, accepterId], name: "uq_friendship")
  @@map("friendships")
  @@index([requesterId], name: "idx_friendships_requester")
  @@index([accepterId], name: "idx_friendships_accepter")
}

model BlockedFriendship {
  id        Int               @id @default(autoincrement())
  blockerId    Int               @map("blocker_id")
  blockedId  Int               @map("blocked_id")
  createdAt DateTime          @default(now()) @map("created_at")

  blocker   User @relation("Blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], name: "uq_blocked_friendship")

  @@map("blocked_friendship")
}

model FriendChatMessage {
  id           Int      @id @default(autoincrement())
  friendshipId Int  
  senderId     Int 
  message      String
  timestamp    DateTime @default(now())

  friendship  Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender      User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([friendshipId], name: "idx_friend_chat_messages_friendship")

  @@map("friend_chat_messages")
}