// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ENUMS
enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum Language {
  english
  chinese
  malay
}

enum userStatus {
  online
  offline
  ingame
}

// MODELS
model User {
  id         Int            @id @default(autoincrement())
  username   String         @unique
  password   String
  email      String         @unique
  avatarUrl  String?        @map("avatar_url")
  status     userStatus     @default(offline) @map("status")
  joinedAt   DateTime       @default(now()) @map("joined_at")
  updatedAt  DateTime       @default(now()) @map("updated_at")

  // Relations
  settings   UserSettings?

  friendshipsUser   Friendship[] @relation("UserFriends")
  friendshipsFriend Friendship[] @relation("FriendUsers")

  blockedUsers       BlockedFriendship[] @relation("Blocks")   // people I blocked
  blockedBy          BlockedFriendship[] @relation("BlockedBy") // people who blocked me

  @@map("users")
}

model UserSettings {
  userId    Int                       @id @map("user_id")
  language  Language                  @default(english)

  // Relation
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Friendship {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  friendId  Int               @map("friend_id")
  status    FriendshipStatus  @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @map("updated_at")

  // Relations
  user      User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId], name: "uq_friendship")
  @@map("friendships")
  @@index([userId], name: "idx_friendships_user")
  @@index([friendId], name: "idx_friendships_friend")
}

model BlockedFriendship {
  id        Int               @id @default(autoincrement())
  blockerId    Int               @map("blocker_id")
  blockedId  Int               @map("blocked_id")
  createdAt DateTime          @default(now()) @map("created_at")

  blocker   User @relation("Blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], name: "uq_blocked_friendship")

  @@map("blocked_user")
}

