{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npx nodemon --watch src --exec tsx src/server.ts",
    "dev2": "nodemon --watch src --exec ts-node src/loginApp.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "start2": "node dist/app.js",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "npx prettier --check \"src/**/*.{ts,js,json,md}\"",
    "format:fix": "npx prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "allowImportingTsExtensions": true,
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "pako": "^2.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "prisma": "^6.15.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
