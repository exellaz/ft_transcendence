meta {
    name: update-room-setting
    type: http
    seq: 5
}

patch {
    url: {{baseUrl}}/room/{{roomId}}/room-setting
    body: json
    auth: inherit
}

headers {
    Content-Type: application/json
}

body:json {
    {
        "isPrivate": true
    }
}

assert {
    res.status: eq 200
    res.body.private: isBoolean
}
