meta {
  name: success
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const userId = Math.random().toString(36).substring(2, 8);
  
  bru.setVar('email', `${userId}@test.com`);
  bru.setVar('username', `user_${userId}`);
  bru.setVar('password', 'Test123!');
}

tests {
  test("should return 201 status and success response", function() {
    expect(res.status).to.equal(201);
    expect(res.body.success).to.be.true;
    expect(res.body).to.have.property('data');
  });
  
  test("should return user with correct credentials and defaults", function() {
    expect(res.body.data.user.email).to.equal(bru.getVar('email'));
    expect(res.body.data.user.username).to.equal(bru.getVar('username'));
    expect(res.body.data.user.id).to.be.a('number').greaterThan(0);
    expect(res.body.data.user.status).to.equal('offline');
    expect(res.body.data.user.avatarUrl).to.equal('/assets/yellow-ghost.png');
  });
  
  test("should return valid JWT token", function() {
    expect(res.body.data.token).to.be.a('string');
    expect(res.body.data.token.split('.')).to.have.length(3);
    expect(res.body.data.token.length).to.be.greaterThan(50);
  });
  
  test("should follow security and API patterns", function() {
    expect(res.body.data.user).to.not.have.property('password');
    expect(res.body).to.not.have.property('error');
    expect(res.body).to.not.have.property('errorCode');
    expect(res.body.data.user.username).to.match(/^[a-zA-Z0-9_-]+$/);
    expect(res.body.data.user.email).to.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/);
  });
}
