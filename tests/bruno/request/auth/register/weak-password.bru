meta {
  name: weak-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "weakpassuser",
    "email": "weak@transcendence.local",
    "password": "weak12345"
  }
}

tests {
  test("should return 400 validation error", function() {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("should have validation error response", function() {
    const body = res.getBody();
    expect(body).to.have.property('success', false);
    expect(body).to.have.property('error');
  });
}
