meta {
  name: weak-password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const userId = Math.random().toString(36).substring(2, 8);
  
  bru.setVar('email', `weak${userId}@test.com`);
  bru.setVar('username', `weak${userId}`);
  bru.setVar('password', 'weak');
}

tests {
  test("should return 400 status for weak password", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.be.false;
  });
  
  test("should return proper validation error", function() {
    expect(res.body.error).to.be.a('string');
    expect(res.body.errorCode).to.equal('PASSWORD_TOO_SHORT');
    expect(res.body).to.not.have.property('data');
  });
  
  test("should follow ApiResponse error pattern", function() {
    expect(res.body).to.have.property('success', false);
    expect(res.body).to.have.property('error');
    expect(res.body).to.have.property('errorCode');
  });
}
