meta {
  name: invalid-username
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const userId = Math.random().toString(36).substring(2, 8);
  
  bru.setVar('email', `invalid${userId}@test.com`);
  bru.setVar('username', 'user with spaces');
  bru.setVar('password', 'ValidPass123!');
}

tests {
  test("should return 400 status for invalid username format", function() {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.be.false;
  });
  
  test("should return username validation error", function() {
    expect(res.body.error).to.be.a('string');
    expect(res.body.errorCode).to.equal('USERNAME_TOO_LONG');
    expect(res.body).to.not.have.property('data');
  });
  
  test("should follow ApiResponse error pattern", function() {
    expect(res.body).to.have.property('success', false);
    expect(res.body).to.have.property('error');
    expect(res.body).to.have.property('errorCode');
  });
}
