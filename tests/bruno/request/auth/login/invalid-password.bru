meta {
  name: invalid-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar('baseUrl');
  const userId = Math.random().toString(36).substring(2, 8);

  bru.setVar('email', `badpass${userId}@test.com`);
  bru.setVar('username', `badpass${userId}`);
  bru.setVar('correctPassword', 'CorrectPass123!');
  bru.setVar('wrongPassword', 'WrongPass123!');

  const registerResponse = await axios.post(`${baseUrl}/auth/register`, {
    email: `badpass${userId}@test.com`,
    username: `badpass${userId}`,
    password: 'CorrectPass123!'
  }, {
    headers: { 'Content-Type': 'application/json' },
    timeout: 5000
  });

  if (registerResponse.status === 201) {
    console.log(`✅ Created user badpass${userId} for invalid password test`);
  }
}

body:json {
  {
    "identifier": "{{email}}",
    "password": "{{wrongPassword}}"
  }
}

tests {
  test("should return 401 unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("should have error response structure", function() {
    const body = res.getBody();
    expect(body).to.have.property('success', false);
    expect(body).to.have.property('error');
    expect(body.error).to.include('Invalid credentials');
  });

  test("should not leak user existence information", function() {
    const body = res.getBody();
    expect(body.error).to.not.include('user not found');
    expect(body.error).to.not.include('email');
    expect(body.error).to.not.include('username');
  });
}
