meta {
  name: delete-blockedFriendship-success
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/blockedFriendships/1/8
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

settings {
  encodeUrl: true
}

docs {
  -  blockedId = amount of blocked friendships seeded + 1
}
