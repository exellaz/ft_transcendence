meta {
  name: create-blockedFriendship-success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/blockedFriendships
  body: json
  auth: inherit
}

body:json {
  {
    "blockerId": 1,
    "blockedId": 8 // amount of blocked friendships seeded + 1
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
