meta {
  name: patch-user-settings-notfound
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/users/99999999/settings
  body: json
  auth: none
}

body:json {
  {
    "language": "simplified_chinese"
  }
}

assert {
  res.status: eq 404
  res.body.success: eq false
  res.body.error: contains "User not found"
}
