meta {
  name: get-user-fields
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/1
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: isNumber
  res.body.data.username: isString
  res.body.data.email: isString
  res.body.data.usercode: isString
  res.body.data.status: isString
  res.body.data.joinedAt: isString
  res.body.data.updatedAt: isString
}

tests {
  test("Check response body property type or value", function () {
    const myProperty = res.getBody().data.avatarUrl; // Assuming 'myProperty' exists in the response body
  
    // Assert that 'myProperty' is either a string or a number
    expect(myProperty).to.satisfy(
      (val) => typeof val === "string" || typeof val === null
    );
  
  });
}

settings {
  encodeUrl: true
}
