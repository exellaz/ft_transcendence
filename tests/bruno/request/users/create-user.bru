meta {
  name: create-user
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
    // Generate unique username/email every run
    const suffix = Date.now().toString();
    const username = `testuser_${suffix}`;
    const email = `${username}@example.com`;
    const password = `${username}PW`
  
    bru.setVar("username", username);
    bru.setVar("email", email);
    bru.setVar("password", password);
  
    console.log("PreScript -> username:", username, 
                "\nemail:", email, 
                "\npassword:", password);
}

tests {
  test("Check response body contains 'success' property", function ()
  {
    expect(res.getBody()).to.have.property("success");
  });
  
  test("Check if response is successful", function ()
  {
    expect(res.getBody().success).to.be.true;
  });
  
  
  
  // Accept either 200 or 201 for create
  expect(res.status).to.be.oneOf([200, 201]);
  
  test("Check if response has all expected fields", function(){
    expect(res.status).to.be.oneOf([200, 201]);
    expect(res.body.data).to.have.property('id');
    expect(res.body.data).to.have.property('username').that.equals(bru.getVar("username"));
    expect(res.body.data).to.have.property('email').that.equals(bru.getVar("email"));
  
    // Save id for next request
    bru.setVar("userId", res.body.id);
  });
  
  // Basic structure checks
  expect(res.body).to.be.an('object');
  expect(res.body).to.have.property('id');
  expect(res.body).to.have.property('username');
  expect(res.body).to.have.property('email');
  
  // Confirm returned username/email match input
  expect(res.body.username).to.equal("{{username}}");
  expect(res.body.email).to.equal("{{email}}");
  
  // usercode should exist and be a non-empty string (format loosely checked)
  expect(res.body).to.have.property('usercode');
  expect(res.body.usercode).to.be.a('string').and.not.empty;
  expect(res.body.usercode).to.match(/^[A-Za-z0-9_\-]{3,30}$/); // adjust regex to your code rules
  
  // Settings relationship should exist (object) since code uses settings: { create: {} }
  expect(res.body).to.have.property('settings');
  expect(res.body.settings).to.satisfy(s => s === null || typeof s === 'object');
  
  // Password should not be leaked as plain text. If password is present then it must not equal the input password.
  if (res.body.password !== undefined) {
    expect(res.body.password).to.not.equal("{{password}}");
  }
  
  // Save values for later requests in this collection
  setVar("newUserId", res.body.id);
  setVar("newUserCode", res.body.usercode);
}
