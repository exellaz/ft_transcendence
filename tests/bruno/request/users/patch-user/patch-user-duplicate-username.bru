meta {
  name: patch-user-duplicate-username
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/users/1
  body: json
  auth: none
}

body:json {
  {
    "username": "test",
    "avatarUrl": "https://example.com/avatar.png"
  }
}

assert {
	res.status: eq 400
	res.body.success: eq false
	res.body.error: contains "Username already exists"
}
